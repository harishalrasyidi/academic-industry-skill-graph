    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "Ensure that aerodrome procedures are conducted in accordance with all requirements." .

<http://data.europa.eu/esco/node-literal/91cd4c2e-30ff-4b3d-a2dc-d1c67865b9d5> a esco:NodeLiteral ;
    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "The characteristics, tools and techniques for measurement, collection, analysis and reporting of web data to get information on the users' behaviour and to improve the performance of a website." .

