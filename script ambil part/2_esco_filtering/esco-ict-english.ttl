    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "Develop specific goals and plans to prioritise, organise, and accomplish work." .

<http://data.europa.eu/esco/node-literal/0b834d25-b072-457b-b587-b73a20f601ba> a esco:NodeLiteral ;
    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "The directory services that automate the network management of security, user data and distributed resources and enable access to information in a computer system's directory." .

