    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "Develop the database design models and diagrams which establish the structure of a database by using modelling software tools to be implemented in further processes." .

<http://data.europa.eu/esco/node-literal/feff7981-e6ca-4e9c-9007-03cd9defe012> a esco:NodeLiteral ;
    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "Stay informed and adapt to developments, innovations and trends concerning marketing such as marketing tools and marketing technologies." .

