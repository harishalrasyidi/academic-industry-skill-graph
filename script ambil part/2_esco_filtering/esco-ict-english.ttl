    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "ICT network engineers implement, maintain and support computer networks. They also perform network modelling, analysis, and planning. They may also design network and computer security measures. They may research and recommend network and data communications hardware and software." .

<http://data.europa.eu/esco/node-literal/c11962de-36de-46ae-ae37-ee8114bdc9c2> a esco:NodeLiteral ;
    esco:language "en"^^xsd:language ;
