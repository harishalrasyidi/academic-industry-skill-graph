    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "Create and program application interfaces, their operations, inputs and outputs and underlying types." .

<http://data.europa.eu/esco/node-literal/b1b38d8c-369a-4eb7-9b6b-dd4ed4661302> a esco:NodeLiteral ;
    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "Review proposals, progress, impact and outcomes of peer researchers, including through open peer review." .

<http://data.europa.eu/esco/node-literal/b2165d7a-75e2-474d-8175-fa0b16da7e44> a esco:NodeLiteral ;
    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "Disseminate internal communications using the different communication channels that a company has at its disposal." .

<http://data.europa.eu/esco/node-literal/b22145bb-a898-4ef9-9c87-01053dedc92b> a esco:NodeLiteral ;
    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "Outline the research methodologies and schedule in order to ensure that the research can be thoroughly and efficiently executed and that the objectives can be met in a timely manner." .

