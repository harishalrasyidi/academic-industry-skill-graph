    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "Handle components of ICT system by maintaining configuration, managing users, monitoring resource use, performing backups and installing hardware or software to comply with the set requirements." .

<http://data.europa.eu/esco/node-literal/5082a40b-8d68-4ac3-bf2e-48e3e921d8ac> a esco:NodeLiteral ;
    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "Modify content or a product for the transference from one locale to another through the use of content translation or localisation service providers." .

