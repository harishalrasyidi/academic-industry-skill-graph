    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "The process of developing and constructing systems for implementing data collection and analysis at large scale." .

<http://data.europa.eu/esco/node-literal/b361e929-cada-48cd-9cde-d9c673da47fc> a esco:NodeLiteral ;
    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "The distributed ledger theories, applied principles, architectures and systems, such as decentralization, consensus mechanisms, smart contracts, trust, etc." .

<http://data.europa.eu/esco/node-literal/b36896a4-a4dd-4cd7-814d-1be12126d4a4> a esco:NodeLiteral ;
    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "The techniques and principles of software development, such as analysis, algorithms, coding, testing and compiling of programming paradigms in Ruby." .

