    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "Examining data or facts to determine appropriate actions or recommendations; comparing and critically evaluating the credibility and reliability of sources of data; making and defending judgements based on internal evidence and external criteria." .

<http://data.europa.eu/esco/node-literal/550d248a-0a2e-4f99-8cb5-ed01d542b2a1> a esco:NodeLiteral ;
    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "Study musical scores and develop various interpretations." .

