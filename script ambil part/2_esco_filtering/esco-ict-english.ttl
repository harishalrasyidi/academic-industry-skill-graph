    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "The Wireshark tool is a penetration testing tool which evaluates security weaknesses, analysing network protocols through deep protocol inspection, live capture, display filters, offline analysis, VoIP analysis, protocol decryption." .

