    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "Test electrical equipment for malfunctions. Take safety measures, company guidelines, and legislation concerning electrical equipment into account. Clean, repair and replace parts and connections as required." .

<http://data.europa.eu/esco/node-literal/fdddb508-6c71-46de-a583-057f345b4a6d> a esco:NodeLiteral ;
    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "Respond to customers' inquiries and provide customers with appropriate information." .

