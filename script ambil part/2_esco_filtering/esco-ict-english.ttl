    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "Use computer-aided design and drafting software to make detailed drawings and blueprints of designs." .

<http://data.europa.eu/esco/node-literal/c0efbd16-06b7-4791-9365-520d59bf1021> a esco:NodeLiteral ;
    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "The scientific and practical study that deals with the foundations of information and computation, namely algorithms, data structures, programming, and data architecture. It deals with the practicability, structure and mechanisation of the methodical procedures that manage the acquisition, processing, and access to information." .

<http://data.europa.eu/esco/node-literal/c0f28bca-30c1-4dbc-af1b-1a8146d3aafd> a esco:NodeLiteral ;
