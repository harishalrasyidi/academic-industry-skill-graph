    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "Evaluate and monitor the financial health, the operations and financial movements expressed in the financial statements of the company. Revise the financial records to ensure stewardship and governability." .

<http://data.europa.eu/esco/node-literal/544ec773-b964-4127-bc48-71337d382a48> a esco:NodeLiteral ;
    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "Assess new cooking methods by undergoing research activities in order to develop or improve food technological processes." .

<http://data.europa.eu/esco/node-literal/5454c9e9-933c-4737-b0b2-c57b21ebfbd1> a esco:NodeLiteral ;
    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "Identify problems with servers, desktops, printers, networks, and remote access, and perform actions which solve the problems." .

<http://data.europa.eu/esco/node-literal/546bf236-5f6b-45b5-8661-7ec46990c879> a esco:NodeLiteral ;
    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "Provide resources and prepare employee training activities and workshops; increase efficiency of warehouse operations." .

