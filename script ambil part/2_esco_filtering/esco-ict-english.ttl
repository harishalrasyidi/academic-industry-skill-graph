    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "Be able to judge and manage risks to personal health, for example by following safety precautions in work practices, applying fire protection measures, respecting and applying ergonomics and taking account of the effects of drugs and alcohol on individuals, families and communities." .

<http://data.europa.eu/esco/node-literal/fff76b8a-1d3b-4b54-bb11-063cb5c0899d> a esco:NodeLiteral ;
    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "The techniques for recovering hardware or software components and data, after failure, corruption or damage." .

