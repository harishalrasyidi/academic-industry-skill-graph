    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "Create financial and statistical reports based on collected data which are to be presented to managing bodies of an organisation." .

<http://data.europa.eu/esco/node-literal/365d32a6-b5cc-4f7d-8e6a-a5ed26ec9b95> a esco:NodeLiteral ;
    esco:language "en"^^xsd:language ;
    esco:nodeLiteral "Write or redact contributions for a specialised publication in your field." .

